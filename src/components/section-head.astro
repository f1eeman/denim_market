---
interface Props {
  title: string
  id: string
  more?: { label: string; href: string }
  reveal?: boolean
}

const { title, id, more, reveal = true } = Astro.props
---

<div class="head" data-reveal={reveal ? '' : undefined}>
  <h2 class="title" id={`${id}-title`}>{title}</h2>
  {
    more && (
      <a class="more" href={more.href}>
        {more.label}
      </a>
    )
  }
</div>

<style>
  .head {
    display: flex;
    gap: 16px;
    align-items: baseline;
    justify-content: space-between;
  }

  .title {
    font-weight: 700;
    font-size: var(--text-section);
    line-height: normal;
  }

  .more {
    position: relative;
    flex: none;
    padding-inline: 5px;
    padding-block-end: 4px;
    border-block-end: 2px solid currentcolor;
    font-weight: 500;
    white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    user-select: none;
    transition: color 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
  }

  .more::after {
    content: '';
    position: absolute;
    inset: -9px -8px;
  }

  @media (hover: hover) and (pointer: fine) {
    .more:hover {
      color: var(--color-text-muted);
    }
  }

  .more:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 4px;
  }

  .more:active {
    color: var(--color-text-muted);
    transition-duration: 90ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .more {
      transition: none;
    }
  }
</style>
