---
import SectionHead from '@/components/section-head.astro'
import ProductGrid from '@/components/product-grid.astro'
import ProductCard from '@/components/product-card.astro'
import { RELATED } from '@/data/shop'
import { TILE_RATIO, TILE_SIZES } from '@/data/grid'
---

<section
  class="section"
  id="related"
  data-region
  aria-labelledby="related-title"
>
  <div class="container">
    <SectionHead
      id="related"
      title="You may also like"
      more={{ label: 'View all', href: '/catalog' }}
    />
    <ProductGrid>
      {
        RELATED.map((tile) => (
          <li>
            <ProductCard
              name={tile.name}
              price={tile.price}
              photo={tile.photo}
              href="/product"
              sizes={TILE_SIZES}
              ratio={TILE_RATIO}
            />
          </li>
        ))
      }
    </ProductGrid>
  </div>
</section>
