---
import SearchIcon from '@/img/icons/search.svg'
import CartIcon from '@/img/icons/cart.svg'
import { NAV } from '@/data/shop'
---

<header class="header">
  <div class="container row">
    <details class="menu" data-menu>
      <summary
        class="menu-toggle"
        data-menu-toggle
        data-menu-label-open="Open menu"
        data-menu-label-close="Close menu"
      >
        <span class="visually-hidden" data-menu-label>Open menu</span>
        <span class="burger" aria-hidden="true"></span>
      </summary>
      <nav class="nav" aria-label="Sections">
        <ul class="nav-list">
          {
            NAV.map((link) => (
              <li>
                <a class="nav-link" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>

    <a class="logo" href="/">Nîmes</a>

    <div class="tools">
      <form class="search" action="/catalog" method="get" data-search>
        <button
          class="icon-button"
          type="button"
          data-search-toggle
          aria-expanded="false"
          aria-controls="search-field"
        >
          <span class="visually-hidden">Search</span>
          <SearchIcon width="20" height="20" aria-hidden="true" />
        </button>
        <input
          class="search-field"
          id="search-field"
          type="search"
          name="q"
          placeholder="Search"
          aria-label="Search products"
          data-search-field
        />
      </form>

      <button
        class="icon-button cart"
        type="button"
        data-cart-toggle
        aria-expanded="false"
        aria-controls="cart-panel"
      >
        <span class="visually-hidden">Cart</span>
        <CartIcon width="22" height="20" aria-hidden="true" />
        <span class="badge" data-cart-count hidden>0</span>
      </button>
    </div>

    <p class="visually-hidden" role="status" data-cart-status></p>

    <div class="cart-panel" id="cart-panel" data-cart-panel hidden>
      <p class="cart-empty" data-cart-empty>Your cart is empty.</p>
      <ul class="cart-list" data-cart-list></ul>
      <p class="cart-total" data-cart-total hidden></p>
    </div>
  </div>
</header>

<style>
  .header {
    position: relative;
    z-index: 2;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-block-size: var(--header-height);
  }

  .logo {
    grid-column: 2;
    font-weight: 800;
    font-size: 24px;
    line-height: normal;
    white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    user-select: none;
  }

  .logo:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 4px;
  }

  .tools {
    grid-column: 3;
    display: flex;
    gap: var(--inline-gap);
    align-items: center;
    justify-content: flex-end;
  }

  .search {
    display: flex;
    gap: 12px;
    align-items: center;
    min-inline-size: 0;
  }

  .search-field {
    inline-size: 0;
    min-inline-size: 0;
    padding: 0;
    border: 0;
    border-block-end: 2px solid transparent;
    background-color: transparent;
    color: inherit;
    font: inherit;
    font-size: var(--text-note);
    opacity: 0;
    pointer-events: none;
    transition:
      inline-size 180ms cubic-bezier(0.2, 0.8, 0.25, 1),
      opacity 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
  }

  .search-field::placeholder {
    color: var(--color-text-muted);
    opacity: 1;
  }

  .search[data-search-open] .search-field {
    inline-size: clamp(120px, 26vw, 240px);
    border-block-end-color: var(--color-text);
    opacity: 1;
    pointer-events: auto;
  }

  .search-field:focus-visible {
    outline: none;
    border-block-end-color: var(--color-text);
  }

  .icon-button {
    position: relative;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    user-select: none;
    transition: opacity 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
  }

  .icon-button::after {
    content: '';
    position: absolute;
    inset: -12px;
  }

  @media (hover: hover) and (pointer: fine) {
    .icon-button:hover {
      opacity: 0.6;
    }
  }

  .icon-button:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 6px;
  }

  .icon-button:active {
    opacity: 0.45;
    transition-duration: 90ms;
  }

  .badge {
    position: absolute;
    animation: panel-in 180ms cubic-bezier(0.2, 0.8, 0.25, 1) backwards;
    inset-block-start: -8px;
    inset-inline-start: 12px;
    display: grid;
    place-items: center;
    min-inline-size: 16px;
    block-size: 16px;
    padding-inline: 4px;
    border-radius: 8px;
    background-color: var(--color-surface-inverse);
    color: var(--color-text-inverse);
    font-weight: 700;
    font-size: 10px;
    line-height: 1;
  }

  .cart-panel {
    position: absolute;
    animation: panel-in 180ms cubic-bezier(0.2, 0.8, 0.25, 1) backwards;
    inset-inline-end: var(--layout-gutter);
    inset-block-start: calc(var(--header-height) - 4px);
    z-index: 10;
    inline-size: min(320px, calc(100vw - var(--layout-gutter) * 2));
    padding: 20px;
    background-color: var(--color-surface-muted);
    font-size: var(--text-note);
  }

  .cart-list {
    display: grid;
    gap: 12px;
  }

  .cart-list:empty {
    display: none;
  }

  .cart-line {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 4px 12px;
    align-items: baseline;
  }

  .cart-line-name {
    grid-column: 1;
    font-weight: 500;
  }

  .cart-line-price {
    grid-column: 2;
    grid-row: 1;
    font-weight: 700;
    text-align: end;
  }

  .cart-remove {
    grid-column: 1;
    justify-self: start;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-text-muted);
    font: inherit;
    font-size: 12px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .cart-remove:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 2px;
  }

  @media (hover: hover) and (pointer: fine) {
    .cart-remove:hover {
      color: var(--color-text);
    }
  }

  .cart-total {
    display: flex;
    justify-content: space-between;
    margin-block-start: 16px;
    padding-block-start: 12px;
    border-block-start: 2px solid var(--color-track);
    font-weight: 700;
  }

  .nav-link {
    display: block;
    font-weight: 500;
    white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    user-select: none;
    transition: color 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
  }

  @media (width < 665px) {
    .menu {
      grid-column: 1;
      justify-self: start;
    }

    .menu-toggle {
      position: relative;
      display: grid;
      place-content: center;
      inline-size: 24px;
      block-size: 20px;
      list-style: none;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      touch-action: manipulation;
      user-select: none;
    }

    .menu-toggle::-webkit-details-marker {
      display: none;
    }

    .menu-toggle::after {
      content: '';
      position: absolute;
      inset: -12px;
    }

    .menu-toggle:focus-visible {
      outline: 2px solid var(--color-text);
      outline-offset: 6px;
    }

    .burger,
    .burger::before,
    .burger::after {
      inline-size: 24px;
      block-size: 2px;
      background-color: var(--color-text);
      transition: transform 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
    }

    .burger {
      position: relative;
    }

    .burger::before,
    .burger::after {
      content: '';
      position: absolute;
      inset-inline-start: 0;
    }

    .burger::before {
      inset-block-start: -7px;
    }

    .burger::after {
      inset-block-start: 7px;
    }

    .menu[open] .burger {
      background-color: transparent;
    }

    .menu[open] .burger::before {
      transform: translateY(7px) rotate(45deg);
    }

    .menu[open] .burger::after {
      transform: translateY(-7px) rotate(-45deg);
    }

    .menu::details-content {
      transition: content-visibility 180ms allow-discrete;
    }

    .nav {
      position: absolute;
      inset-inline: 0;
      inset-block-start: 100%;
      z-index: 10;
      block-size: 0;
      background-color: var(--color-surface-inverse);
      overflow: hidden;
      transition: block-size 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
    }

    .menu[open] .nav {
      block-size: auto;
    }

    .nav-list {
      max-block-size: calc(100dvh - var(--header-height));
      padding: 8px var(--layout-gutter) 16px;
      overflow-y: auto;
    }

    .nav-link {
      padding-block: 12px;
      color: var(--color-text-inverse);
    }

    .nav-link:focus-visible {
      outline: 2px solid var(--color-text-inverse);
      outline-offset: 2px;
    }

    .nav-link:active {
      background-color: rgb(255 255 255 / 5%);
    }
  }

  @media (width >= 665px) {
    .menu {
      grid-column: 1;
    }

    .menu-toggle {
      display: none;
    }

    .menu::details-content {
      block-size: auto;
      content-visibility: visible;
    }

    .nav-list {
      display: flex;
      gap: var(--inline-gap);
    }

    .nav-link {
      position: relative;
      font-size: var(--text-note);
    }

    .nav-link::after {
      content: '';
      position: absolute;
      inset-block-end: -4px;
      inset-inline: 0;
      block-size: 2px;
      background-color: currentcolor;
      transform: scaleX(0);
      transform-origin: right;
      transition: transform 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
    }

    .nav-link:focus-visible {
      outline: 2px solid var(--color-text);
      outline-offset: 4px;
    }

    .nav-link:active {
      transform: scale(0.97);
    }

    @media (hover: hover) and (pointer: fine) {
      .nav-link:hover::after {
        transform: scaleX(1);
        transform-origin: left;
      }
    }
  }

  @keyframes panel-in {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cart-panel,
    .badge {
      animation: none;
    }

    .nav,
    .nav-link,
    .nav-link::after,
    .burger,
    .burger::before,
    .burger::after,
    .menu::details-content,
    .icon-button,
    .search-field {
      transition: none;
    }

    .nav-link:active {
      transform: none;
    }
  }
</style>
