---
import Facebook from '@/img/icons/facebook.svg'
import Instagram from '@/img/icons/instagram.svg'
import Pinterest from '@/img/icons/pinterest.svg'
import Twitter from '@/img/icons/twitter.svg'
import { FOOTER_LINKS, SOCIALS } from '@/data/shop'

const GLYPHS = {
  Facebook,
  Instagram,
  Pinterest,
  Twitter,
}
---

<footer class="footer">
  <div class="container inner">
    <a class="logo" href="/">Nîmes</a>

    <nav aria-label="Footer">
      <ul class="links">
        {
          FOOTER_LINKS.map((link) => (
            <li>
              <a class="link" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ul class="socials" id="contacts" aria-label="Social profiles">
      {
        SOCIALS.map((social) => {
          const Glyph = GLYPHS[social.name as keyof typeof GLYPHS]

          return (
            <li>
              <a class="social" href={social.href} rel="noopener noreferrer">
                <span class="visually-hidden">{social.name}</span>
                <Glyph aria-hidden="true" />
              </a>
            </li>
          )
        })
      }
    </ul>
  </div>
</footer>

<style>
  .footer {
    padding-block: 44px 50px;
    background-color: var(--color-surface-inverse);
    color: var(--color-text-inverse);
  }

  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .logo {
    font-weight: 800;
    font-size: 24px;
    line-height: normal;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .logo:focus-visible,
  .link:focus-visible,
  .social:focus-visible {
    outline: 2px solid var(--color-text-inverse);
    outline-offset: 4px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px var(--inline-gap);
    justify-content: center;
    margin-block-start: 15px;
  }

  .link {
    display: block;
    padding-block: 10px;
    font-weight: 500;
    white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    transition: opacity 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
  }

  .socials {
    display: flex;
    gap: 29px;
    align-items: center;
    justify-content: center;
    margin-block-start: 23px;
  }

  .social {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: 20px;
    block-size: 20px;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    transition: opacity 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
  }

  .social::after {
    content: '';
    position: absolute;
    inset: -12px;
  }

  .social :global(svg) {
    display: block;
    max-inline-size: 100%;
    max-block-size: 100%;
  }

  @media (hover: hover) and (pointer: fine) {
    .link:hover,
    .social:hover,
    .logo:hover {
      opacity: 0.6;
    }
  }

  .link:active,
  .social:active,
  .logo:active {
    opacity: 0.45;
    transition-duration: 90ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .link,
    .social,
    .logo {
      transition: none;
    }
  }
</style>
