---
import { Image } from 'astro:assets'
import Button from '@/components/button.astro'
import Hatch from '@/components/hatch.astro'
import ScrollCue from '@/img/icons/scroll-cue.svg'
import portrait from '@/img/promo-portrait.jpg'
import { PROMO } from '@/data/shop'
---

<section
  class="promo section"
  id="promo"
  data-band
  data-scene-cue-carrier
  aria-labelledby="promo-title"
>
  <div class="container inner">
    <div class="text">
      <p class="eyebrow">{PROMO.eyebrow}</p>
      <h1 class="title" id="promo-title">{PROMO.title}</h1>
      <Button as="a" href={PROMO.action.href} width="auto" class="action">
        {PROMO.action.label}
      </Button>
    </div>

    <div class="stage">
      <Hatch class="hatch-top" />
      <Image
        class="portrait"
        src={portrait}
        alt="Model in a denim jacket"
        widths={[430, 860]}
        sizes="(width >= 1366px) 430px, (width >= 1168px) calc(85.652vw - 290px), min(530px, 85.652vw)"
        loading="eager"
      />
      <Hatch flip class="hatch-bottom" />
    </div>

    <a class="cue" href="#bestsellers">
      <span class="visually-hidden">Skip to bestsellers</span>
      <ScrollCue
        class="cue-glyph"
        width="12"
        height="29"
        data-scene-cue
        aria-hidden="true"
      />
    </a>
  </div>
</section>

<style>
  .promo {
    background-color: var(--color-surface-muted);
  }

  .inner {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-block: 40px;
  }

  .eyebrow {
    color: var(--color-text-muted);
  }

  .title {
    margin-block-start: 20px;
    font-family: var(--font-anton);
    font-weight: 400;
    font-size: 72px;
    line-height: 1;
    letter-spacing: 0.01em;
  }

  .action {
    margin-block-start: 32px;
  }

  .stage {
    position: relative;
    inline-size: 100%;
    max-inline-size: 530px;
    margin-block-start: 40px;
    aspect-ratio: 530 / 617;
  }

  .hatch-top,
  .hatch-bottom {
    position: absolute;
    inline-size: 43.774%;
    block-size: 28.525%;
  }

  .hatch-top {
    inset-block-start: 0;
    inset-inline-start: 0;
  }

  .hatch-bottom {
    inset-block-end: 0;
    inset-inline-end: 0;
  }

  .promo :global(.portrait) {
    position: absolute;
    inset-block-start: 8.104%;
    inset-inline-start: 9.434%;
    inline-size: 81.132%;
    block-size: 83.846%;
    object-fit: cover;
    object-position: bottom;
  }

  .cue {
    display: grid;
    place-items: center;
    inline-size: 44px;
    block-size: 44px;
    margin-block-start: 24px;
    margin-inline-start: -16px;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    transition: transform 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
  }

  .cue:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 2px;
  }

  @media (hover: hover) and (pointer: fine) {
    .cue:hover {
      transform: translateY(4px);
    }
  }

  .cue:active {
    transform: translateY(2px);
    transition-duration: 90ms;
  }

  @media (prefers-reduced-motion: no-preference) {
    .eyebrow,
    .title {
      animation: promo-rise var(--motion-tick) var(--motion-ease) backwards;
    }

    .title {
      animation-delay: var(--motion-step);
    }

    .action,
    .cue,
    .hatch-top,
    .hatch-bottom {
      animation: promo-fade var(--motion-tick) var(--motion-ease) backwards;
    }

    .hatch-bottom {
      animation-name: promo-fade-flip;
      animation-delay: calc(var(--motion-step) * 2);
    }

    .action {
      animation-delay: calc(var(--motion-step) * 2);
    }

    .cue {
      animation-delay: calc(var(--motion-step) * 3);
    }
  }

  @keyframes promo-rise {
    from {
      transform: translateY(var(--motion-shift));
      opacity: 0;
    }
  }

  @keyframes promo-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes promo-fade-flip {
    from {
      transform: scaleY(-1);
      opacity: 0;
    }
  }

  @media (width >= 665px) {
    .title {
      font-size: 96px;
    }
  }

  @media (width >= 1168px) {
    .inner {
      flex-direction: row;
      align-items: flex-start;
      padding-block: 0;
      padding-inline: calc(var(--layout-gutter) + 170px)
        calc(var(--layout-gutter) + 120px);
    }

    .text {
      flex: 1;
      min-inline-size: 0;
      padding-block-start: 188px;
    }

    .title {
      font-size: 128px;
    }

    .action {
      margin-block-start: 27px;
    }

    .stage {
      flex: none;
      inline-size: 530px;
      max-inline-size: none;
      margin-block-start: 0;
      block-size: 617px;
      aspect-ratio: auto;
    }

    .cue {
      position: absolute;
      inset-inline-start: calc(var(--layout-gutter) - 16px);
      inset-block-end: 42px;
      margin: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cue {
      transition: none;
    }

    .cue:active {
      transform: none;
    }

    @media (hover: hover) and (pointer: fine) {
      .cue:hover {
        transform: none;
      }
    }
  }
</style>
