---
import Button from '@/components/button.astro'
import ProductGallery from '@/components/product-gallery.astro'
import { PRODUCT } from '@/data/shop'
---

<section
  class="detail section"
  id="product"
  data-band
  aria-labelledby="product-title"
>
  <div class="container inner">
    <ProductGallery />

    <div class="info">
      <span class="plate" aria-hidden="true"></span>
      <h1 class="title" id="product-title">{PRODUCT.name}</h1>
      <p class="description">{PRODUCT.description}</p>

      <div class="choice" role="radiogroup" aria-labelledby="color-label">
        <span class="label" id="color-label">Color</span>
        <div class="swatches">
          {
            PRODUCT.colors.map((color, index) => (
              <span class="swatch-slot">
                <input
                  class="visually-hidden"
                  type="radio"
                  name="color"
                  id={`color-${color.id}`}
                  value={color.label}
                  checked={index === 0}
                  data-choice="color"
                />
                <label
                  class="swatch"
                  for={`color-${color.id}`}
                  style={{ '--swatch': color.color }}
                >
                  <span class="visually-hidden">{color.label}</span>
                </label>
              </span>
            ))
          }
        </div>
      </div>

      <div class="choice" role="radiogroup" aria-labelledby="size-label">
        <span class="label" id="size-label">Size</span>
        <div class="sizes">
          {
            PRODUCT.sizes.map((size) => (
              <span class="size-slot">
                <input
                  class="visually-hidden"
                  type="radio"
                  name="size"
                  id={`size-${size}`}
                  value={size}
                  checked={size === PRODUCT.defaultSize}
                  data-choice="size"
                />
                <label class="size" for={`size-${size}`}>
                  {size}
                </label>
              </span>
            ))
          }
        </div>
      </div>

      <p class="price">${PRODUCT.price}</p>

      <Button
        class="action"
        data-cart-add
        data-cart-id={PRODUCT.id}
        data-cart-name={PRODUCT.name}
        data-cart-price={String(PRODUCT.price)}
      >
        Add to cart
      </Button>
    </div>
  </div>
</section>

<style>
  .detail {
    margin-block-start: 32px;
  }

  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
  }

  .info {
    position: relative;
    margin-inline: calc(var(--layout-gutter) * -1);
    padding: 32px var(--layout-gutter) 40px;
    background-color: var(--color-surface-muted);
  }

  .plate {
    display: none;
  }

  @media (width >= 1168px) and (prefers-reduced-motion: no-preference) {
    .info {
      overflow: hidden;
    }

    .plate {
      position: absolute;
      inset: 0;
      z-index: 1;
      display: block;
      background-color: var(--color-surface-muted);
      animation: plate-open var(--motion-tick) var(--motion-ease) forwards;
      pointer-events: none;
    }
  }

  @keyframes plate-open {
    to {
      transform: translateX(101%);
    }
  }

  .title {
    font-weight: 700;
    font-size: var(--text-section);
    line-height: normal;
  }

  .description {
    max-inline-size: 370px;
    margin-block-start: 24px;
    font-size: var(--text-note);
  }

  .choice {
    margin-block-start: 32px;
  }

  .label {
    display: block;
    font-weight: 500;
  }

  .swatches {
    display: flex;
    gap: 30px;
    margin-block-start: 24px;
    margin-inline-start: 3px;
  }

  .swatch-slot {
    display: block;
    line-height: 0;
  }

  .swatch {
    position: relative;
    display: block;
    inline-size: 16px;
    block-size: 16px;
    border-radius: 50%;
    background-color: var(--swatch);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .swatch::after {
    content: '';
    position: absolute;
    inset: -14px;
  }

  input:checked + .swatch {
    outline: 1px solid var(--swatch);
    outline-offset: 2px;
  }

  input:focus-visible + .swatch {
    outline: 2px solid var(--color-text);
    outline-offset: 4px;
  }

  .sizes {
    display: flex;
    gap: 20px;
    margin-block-start: 17px;
  }

  .size-slot {
    display: block;
  }

  .size {
    position: relative;
    display: block;
    color: var(--color-text-muted);
    font-weight: 500;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    user-select: none;
    transition:
      color 180ms cubic-bezier(0.2, 0.8, 0.25, 1),
      transform 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
  }

  .size::after {
    content: '';
    position: absolute;
    inset: -12px -8px;
  }

  input:checked + .size {
    color: var(--color-text);
  }

  input:checked + .size::before {
    content: '';
    position: absolute;
    inset-block-end: -4px;
    inset-inline: 0;
    block-size: 2px;
    background-color: currentcolor;
  }

  .size:active {
    transform: scale(0.97);
    transition-duration: 90ms;
  }

  input:focus-visible + .size {
    outline: 2px solid var(--color-text);
    outline-offset: 4px;
  }

  @media (hover: hover) and (pointer: fine) {
    input:not(:checked) + .size:hover {
      color: color-mix(in srgb, var(--color-text) 50%, var(--color-text-muted));
    }

    .swatch:hover {
      outline: 1px solid var(--color-text-muted);
      outline-offset: 2px;
    }

    input:checked + .swatch:hover {
      outline-color: var(--swatch);
    }
  }

  .price {
    margin-block-start: 32px;
    font-weight: 700;
  }

  .action {
    margin-block-start: 32px;
  }

  @media (width >= 665px) {
    .info {
      padding-block: 48px 56px;
    }
  }

  @media (width >= 1168px) {
    .detail {
      margin-block-start: 55px;
    }

    .inner {
      grid-template-columns: minmax(0, 540px) minmax(0, 1fr);
      align-items: start;
      gap: 0 60px;
    }

    .info {
      margin-inline: 0 calc(var(--layout-gutter) * -1);
      padding: 62px 70px 70px;
    }

    .description {
      margin-block-start: 28px;
    }

    .choice {
      margin-block-start: 42px;
    }

    .choice + .choice {
      margin-block-start: 39px;
    }

    .price {
      margin-block-start: 32px;
    }

    .action {
      margin-block-start: 46px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .size {
      transition: none;
    }

    .size:active {
      transform: none;
    }
  }
</style>
