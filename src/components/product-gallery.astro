---
import { Image } from 'astro:assets'
import GalleryArrow from '@/img/icons/gallery-arrow.svg'
import { PRODUCT } from '@/data/shop'

const SHOT_SIZES = 'min(400px, 85.652vw)'
---

<div class="gallery" data-gallery>
  <div class="viewport">
    <button class="arrow prev" type="button" data-gallery-prev>
      <span class="visually-hidden">Previous shot</span>
      <GalleryArrow class="glyph" width="12" height="22" aria-hidden="true" />
    </button>

    <div class="frame">
      {
        PRODUCT.shots.map((shot, index) => (
          <Image
            class="slide"
            src={shot}
            alt={`${PRODUCT.name} — shot ${String(index + 1)}`}
            widths={[400, 800]}
            sizes={SHOT_SIZES}
            loading={index === 0 ? 'eager' : 'lazy'}
            data-gallery-slide={String(index)}
            hidden={index > 0}
          />
        ))
      }
    </div>

    <button class="arrow next" type="button" data-gallery-next>
      <span class="visually-hidden">Next shot</span>
      <GalleryArrow class="glyph" width="12" height="22" aria-hidden="true" />
    </button>
  </div>

  <p class="visually-hidden" role="status" data-gallery-status></p>

  <ul class="thumbs">
    {
      PRODUCT.shots.map((shot, index) => (
        <li>
          <button
            class="thumb"
            type="button"
            data-gallery-thumb={String(index)}
            aria-current={index === 0 ? 'true' : 'false'}
          >
            <span class="visually-hidden">{`Shot ${String(index + 1)}`}</span>
            <Image
              class="thumb-photo"
              src={shot}
              alt=""
              widths={[85, 170]}
              sizes="85px"
            />
          </button>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .gallery {
    min-inline-size: 0;
  }

  .viewport {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
  }

  .frame {
    position: relative;
    inline-size: 100%;
    max-inline-size: 400px;
    margin-inline: auto;
    aspect-ratio: 400 / 523;
    overflow: hidden;
  }

  .slide {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .slide[data-gallery-current] {
    z-index: 1;
  }

  .slide[hidden] {
    display: none;
  }

  .arrow {
    position: relative;
    display: none;
    place-items: center;
    inline-size: 12px;
    block-size: 22px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    user-select: none;
    transition: opacity 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
  }

  .arrow::after {
    content: '';
    position: absolute;
    inset: -16px;
  }

  .prev .glyph {
    transform: rotate(90deg);
  }

  .next .glyph {
    transform: rotate(-90deg);
  }

  @media (hover: hover) and (pointer: fine) {
    .arrow:hover {
      opacity: 0.55;
    }
  }

  .arrow:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 8px;
  }

  .arrow:active {
    opacity: 0.4;
    transition-duration: 90ms;
  }

  .thumbs {
    display: flex;
    gap: 20px;
    min-inline-size: 0;
    max-inline-size: calc(400px + 8px);
    margin-block: calc(20px - 4px) -4px;
    margin-inline: auto;
    padding: 4px;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-padding: 4px;
    scrollbar-width: none;
  }

  .thumbs::-webkit-scrollbar {
    display: none;
  }

  .thumb {
    position: relative;
    display: block;
    flex: none;
    inline-size: 85px;
    block-size: 113px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    transition: opacity 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
  }

  .thumb-photo {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .thumb[aria-current='false'] {
    opacity: 0.55;
  }

  .thumb:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 3px;
  }

  .thumb:active {
    opacity: 0.4;
    transition-duration: 90ms;
  }

  @media (hover: hover) and (pointer: fine) {
    .thumb[aria-current='false']:hover {
      opacity: calc((0.55 + 1) / 2);
    }
  }

  @media (width >= 1168px) {
    .viewport {
      grid-template-columns: 12px minmax(0, 1fr) 12px;
      column-gap: 58px;
    }

    .frame {
      grid-column: 2;
      max-inline-size: 400px;
    }

    .arrow {
      display: grid;
    }

    .prev {
      grid-column: 1;
      grid-row: 1;
    }

    .next {
      grid-column: 3;
      grid-row: 1;
    }

    .thumbs {
      margin-inline: calc(70px - 4px) auto;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .thumbs {
      scroll-behavior: smooth;
    }

    .slide[data-gallery-current] {
      animation: shot-in 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
    }
  }

  @media (width >= 1168px) and (prefers-reduced-motion: no-preference) {
    .thumbs > li {
      animation: thumb-in var(--motion-tick) var(--motion-ease) backwards;
    }

    .thumbs > li:nth-child(2) {
      animation-delay: var(--motion-step);
    }

    .thumbs > li:nth-child(3) {
      animation-delay: calc(var(--motion-step) * 2);
    }

    .thumbs > li:nth-child(4) {
      animation-delay: calc(var(--motion-step) * 3);
    }

    .thumbs > li:nth-child(5) {
      animation-delay: calc(var(--motion-step) * 4);
    }
  }

  @keyframes shot-in {
    from {
      opacity: 0;
    }
  }

  @keyframes thumb-in {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .arrow,
    .thumb {
      transition: none;
    }
  }
</style>
