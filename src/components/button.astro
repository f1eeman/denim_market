---
import type { HTMLTag, Polymorphic } from 'astro/types'

type Props<Tag extends HTMLTag = 'button'> = Polymorphic<{ as: Tag }> & {
  width?: 'fixed' | 'auto'
}

const {
  as: Tag = 'button',
  class: className,
  width = 'fixed',
  ...attrs
} = Astro.props
---

<Tag class:list={['base-button', `width-${width}`, className]} {...attrs}>
  <slot />
</Tag>

<style>
  .base-button {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    justify-content: center;
    min-block-size: var(--control-height);
    padding-inline: 24px;
    background-color: var(--color-surface-inverse);
    color: var(--color-text-inverse);
    font: inherit;
    font-weight: 700;
    font-size: var(--text-note);
    line-height: normal;
    text-align: center;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    user-select: none;
    transition:
      background-color 180ms cubic-bezier(0.2, 0.8, 0.25, 1),
      transform 180ms cubic-bezier(0.2, 0.8, 0.25, 1);
  }

  .width-fixed {
    inline-size: min(100%, var(--control-width));
  }

  @media (hover: hover) and (pointer: fine) {
    .base-button:hover {
      background-color: color-mix(
        in srgb,
        var(--color-surface-inverse) 88%,
        #fff
      );
      transform: translateY(-2px);
    }
  }

  .base-button:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 3px;
    transform: translateY(-2px);
  }

  .base-button:active {
    background-color: color-mix(
      in srgb,
      var(--color-surface-inverse) 85%,
      #000
    );
    transform: translateY(0) scale(0.97);
    transition-duration: 90ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .base-button {
      transition: background-color 180ms ease;
    }

    .base-button:focus-visible,
    .base-button:active {
      transform: none;
    }

    @media (hover: hover) and (pointer: fine) {
      .base-button:hover {
        transform: none;
      }
    }
  }
</style>
