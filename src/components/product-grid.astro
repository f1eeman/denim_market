---
interface Props {
  class?: string
  wide?: boolean
  reveal?: boolean
  scene?: boolean
}

const {
  class: className,
  wide = false,
  reveal = true,
  scene = true,
  ...attrs
} = Astro.props
---

<ul
  class:list={['grid', { wide }, className]}
  data-reveal-stagger={reveal ? '' : undefined}
  data-reveal-below={reveal && scene ? '1016' : undefined}
  data-scene-wipe={scene ? '' : undefined}
  {...attrs}
>
  <slot />
</ul>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--grid-gap);
    margin-block-start: var(--block-gap);
  }

  @media (width >= 665px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (width >= 1016px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .wide {
      gap: 62px 66px;
    }
  }
</style>
