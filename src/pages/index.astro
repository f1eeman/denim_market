---
import Layout from '@/layouts/Layout.astro'
import Promo from '@/components/promo.astro'
import Bestsellers from '@/components/bestsellers.astro'
import News from '@/components/news.astro'
import Categories from '@/components/categories.astro'

const title = 'Nîmes — denim you deserve'
const description =
  'Denim jackets, jeans, shirts and overalls from the Nîmes collections. Bestsellers, news and shopping by category.'
---

<Layout {title} {description}>
  <Promo />
  <Bestsellers />
  <News />
  <Categories />
</Layout>
